# procwatch-agentd: OTLP/HTTP + /v1/procmetrics receiver.
# Tables are created from each payload's label (no -l).
#
# Build with `make agent-x86_64` first, then:
#   docker build -f deploy/Dockerfile.agentd -t procwatch/agentd:latest .

FROM debian:bookworm-slim

# The bundle carries its own libpq and transitive dependencies in lib/, found
# via the DT_RPATH of $ORIGIN/lib that scripts/build_agent.sh sets, so the
# base image needs nothing beyond glibc.
COPY build/agent/x86_64/procwatch-agentd /opt/procwatch/procwatch-agentd
COPY build/agent/x86_64/lib/             /opt/procwatch/lib/

RUN chmod 0755 /opt/procwatch/procwatch-agentd && \
    /opt/procwatch/procwatch-agentd -h 2>&1 | head -1

EXPOSE 4318

USER root

ENTRYPOINT ["/opt/procwatch/procwatch-agentd"]
