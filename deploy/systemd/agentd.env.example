# Environment for procwatch-agentd.systemd
# Install as /etc/procwatch/agentd.env (mode 0640, root:procwatch).

# Required: TimescaleDB / PostgreSQL connection string.
PROCWATCH_DB=postgresql://procwatcher:procwatcherpw@127.0.0.1:5432/procwatcherdb

# Optional overrides (defaults match procwatch-agentd -h).
PROCWATCH_BIND=0.0.0.0
PROCWATCH_PORT=4318
PROCWATCH_SCHEMA=procwatch
PROCWATCH_RETENTION_HOURS=168
PROCWATCH_INACTIVE_HOURS=720
PROCWATCH_SPILL_DIR=/var/lib/procwatch/spill

# Optional host-wide /proc scrape (uncomment to enable; usually leave off).
# PROCWATCH_HOST_COLLECT=1
# PROCWATCH_INTERVAL=10
