        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  ts AS \"time\",\n  pid::text AS metric,\n  cpu_pct AS value\nFROM procwatch.inventory_procs\nWHERE $__timeFilter(ts)\nORDER BY 1",
